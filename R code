#Hypergeometric overlap

AD_genes <- read.table("AD_loci.txt",
                       stringsAsFactors = FALSE)[,1]

M.S1A <- length(rownames(dexp.S1A))                     
K.S1A <- sum(rownames(dexp.S1A) %in% AD_genes)           
Nu.S1A <- length(rownames(sig_up.S1A))                    
xu.S1A <- sum(rownames(sig_up.S1A) %in% AD_genes) 

M.S2A <- length(rownames(dexp.S2A))                     
K.S2A <- sum(rownames(dexp.S2A) %in% AD_genes)           
Nu.S2A <- length(rownames(sig_up.S2A))                    
xu.S2A <- sum(rownames(sig_up.S2A) %in% AD_genes)  

M.S3A <- length(rownames(dexp.S3A))                     
K.S3A <- sum(rownames(dexp.S3A) %in% AD_genes)           
Nu.S3A <- length(rownames(sig_up.S3A))                    
xu.S3A <- sum(rownames(sig_up.S3A) %in% AD_genes)  

phyper(xu.S1A - 1, K.S1A, M.S1A - K.S1A, Nu.S1A, lower.tail = FALSE)
phyper(xu.S2A - 1, K.S2A, M.S2A - K.S2A, Nu.S2A, lower.tail = FALSE)
phyper(xu.S3A - 1, K.S3A, M.S3A - K.S3A, Nu.S3A, lower.tail = FALSE)

fold_enrichment.up.S1A <- (xu.S1A / Nu.S1A) / (K.S1A / M.S1A)
fold_enrichment.up.S2A <- (xu.S2A / Nu.S2A) / (K.S2A / M.S2A)
fold_enrichment.up.S3A <- (xu.S3A / Nu.S3A) / (K.S3A / M.S3A)

overlap_genes.S1A <- intersect(rownames(sig_up.S1A), AD_genes)
overlap_genes.S2A <- intersect(rownames(sig_up.S2A), AD_genes)
overlap_genes.S3A <- intersect(rownames(sig_up.S3A), AD_genes)

Nd.S1A <- length(rownames(sig_down.S1A))
xd.S1A <- sum(rownames(sig_down.S1A) %in% AD_genes)
Nd.S2A <- length(rownames(sig_down.S2A))
xd.S2A <- sum(rownames(sig_down.S2A) %in% AD_genes)
Nd.S3A <- length(rownames(sig_down.S3A))
xd.S3A <- sum(rownames(sig_down.S3A) %in% AD_genes)


phyper(xd.S2A - 1, K.S2A, M.S2A - K.S2A, Nd.S2A, lower.tail = FALSE)
phyper(xd.S3A - 1, K.S3A, M.S3A - K.S3A, Nd.S3A, lower.tail = FALSE)
phyper(xd.S1A - 1, K.S1A, M.S1A - K.S1A, Nd.S1A, lower.tail = FALSE)

fold_enrichment.dwn.S1A <- (xd.S1A / Nd.S1A) / (K.S1A / M.S1A)
fold_enrichment.dwn.S2A <- (xd.S2A / Nd.S2A) / (K.S2A / M.S2A)
fold_enrichment.dwn.S3A <- (xd.S3A / Nd.S3A) / (K.S3A / M.S3A)

