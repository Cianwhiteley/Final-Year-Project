#Initial data import and DGE
counts <- read.table("featurecounts.txt", header = TRUE)

row.names(counts) <- counts$Geneid

counts <- counts[ , -c(1:6) ]

Study1.counts <- counts[, grepl("Study1", colnames(counts))]
Study2.counts <- counts[, grepl("Study2", colnames(counts))]
Study3.counts <- counts[, grepl("Study3", colnames(counts))]

orig_namesS1 <- names(Study1.counts)
orig_namesS2 <- names(Study2.counts)
orig_namesS3 <- names(Study3.counts)

clean_names1 <- gsub(".*(Study[0-9]+)_(week[0-9]+)_(WT|KO)_rep([0-9]+).*",
  "\\1_\\2_\\3_rep\\4", orig_namesS1)
clean_names2 <- gsub(".*(Study[0-9]+)_(person[A-B])_(WT|KO)_rep([0-9]+).*",
  "\\1_\\2_\\3_rep\\4", orig_namesS2)
clean_names3 <- gsub( ".*(Study[0-9]+)_(WT|KO)_rep([0-9]+).*",
  "\\1_\\2_rep\\3",orig_namesS3)

colnames(Study1.counts) <- clean_names1
colnames(Study2.counts) <- clean_names2
colnames(Study3.counts) <- clean_names3

metadataS1 <- data.frame( week     = sub(".*_(week[0-9]+)_.*", "\\1", colnames(Study1.counts)),
  genotype = sub(".*_(WT|KO)_rep[0-9]+", "\\1", colnames(Study1.counts)), row.names = colnames(Study1.counts))
metadataS2 <- data.frame(genotype = sub(".*_(WT|KO)_rep[0-9]+$", "\\1", colnames(Study2.counts)),
  person = ifelse(grepl("_person[A-B]_", colnames(Study2.counts)), sub(".*_(person[A-B])_.*", "\\1", 
  colnames(Study2.counts)), NA),row.names = colnames(Study2.counts),stringsAsFactors = FALSE)
metadataS3  <- data.frame(genotype = sub(".*_(WT|KO)_rep[0-9]+", "\\1", colnames(Study3.counts)),
  row.names = colnames(Study3.counts))


dds.S1 <- DESeqDataSetFromMatrix( countData = Study1.counts,
  colData = metadataS1, design = ~ week + genotype)
dds.S2 <- DESeqDataSetFromMatrix(countData = Study2.counts,
  colData = metadataS2,design = ~ person + genotype)
dds.S3 <- DESeqDataSetFromMatrix(countData = Study3.counts,
  colData = metadataS3,design = ~ genotype)

dds.S1$genotype <- factor(dds.S1$genotype, levels = c("WT","KO"))
dim(dds.S1)
dim(dds.S1[rowSums(counts(dds.S1)) > 0, ])
dds.S1 <- dds.S1[rowSums(counts(dds.S1)) > 0, ]
rld.S1 <- rlog(dds.S1, blind=TRUE)

dds.S2$genotype <- factor(dds.S2$genotype, levels = c("WT","KO"))
dim(dds.S2)
dim(dds.S2[rowSums(counts(dds.S2)) > 0, ])
dds.S2 <- dds.S2[rowSums(counts(dds.S2)) > 0, ]
rld.S2 <- rlog(dds.S2, blind=TRUE)

dds.S3$genotype <- factor(dds.S3$genotype, levels = c("WT","KO"))
dim(dds.S3)
dim(dds.S3[rowSums(counts(dds.S3)) > 0, ])
dds.S3 <- dds.S3[rowSums(counts(dds.S3)) > 0, ]
rld.S3 <- rlog(dds.S3, blind=TRUE)

PCA.S1 <- plotPCA(rld.S1, intgroup= ("genotype")) +
  geom_text(aes(label=name), hjust="inward", vjust=2, size=2)
PCA.S2 <- plotPCA(rld.S2, intgroup= c("genotype", "person")) + 
  geom_text(aes(label=name), hjust="inward", vjust=2, size=2)
PCA.S3 <- plotPCA(rld.S3, intgroup= ("genotype")) + 
  geom_text(aes(label=name),hjust="inward", vjust=2, size=2)

(PCA.S1 | PCA.S2 | PCA.S3) +
  plot_annotation( title = "PCA of Samples Across Three Studies",
    theme = theme(plot.title = element_text(size = 18, face = "bold", hjust = 0.5)))

sampleDists.S1 <- dist(t(assay(rld.S1)))
sampleDists.S2 <- dist(t(assay(rld.S2)))
sampleDists.S3 <- dist(t(assay(rld.S3)))

sampleDistMatrix.S1 <- as.matrix( sampleDists.S1 )
sampleDistMatrix.S2 <- as.matrix( sampleDists.S2 )
sampleDistMatrix.S3 <- as.matrix( sampleDists.S3 )

rownames(sampleDistMatrix.S1) <- rld.S1$genotype
rownames(sampleDistMatrix.S2) <- rld.S2$genotype
rownames(sampleDistMatrix.S3) <- rld.S3$genotype

rownames(sampleDistMatrix.S1) <- paste( rld.S1$genotype, rld.S1$week, sep = " - " )
rownames(sampleDistMatrix.S2) <- paste( rld.S2$genotype, rld.S2$person, sep = " - " )
rownames(sampleDistMatrix.S3) <- paste( rld.S3$genotype, sep = " - " )

colnames(sampleDistMatrix.S1) <- NULL
colnames(sampleDistMatrix.S2) <- NULL
colnames(sampleDistMatrix.S3) <- NULL

colors <- colorRampPalette( rev(brewer.pal(9, "Blues")) )(255)

HC.map.S1 <- pheatmap( sampleDistMatrix.S1, clustering_distance_rows = sampleDists.S1,
  clustering_distance_cols = sampleDists.S1,col = colors, silent = TRUE)
HC.map.S2 <- pheatmap( sampleDistMatrix.S2, clustering_distance_rows = sampleDists.S2,
  clustering_distance_cols = sampleDists.S2,col = colors, silent = TRUE)
HC.map.S3 <- pheatmap( sampleDistMatrix.S3,clustering_distance_rows = sampleDists.S3,
  clustering_distance_cols = sampleDists.S3,col = colors, silent = TRUE)

HC.map.S1 <- as.ggplot(HC.map.S1$gtable)
HC.map.S2 <- as.ggplot(HC.map.S2$gtable)
HC.map.S3 <- as.ggplot(HC.map.S3$gtable)

(HC.map.S1 / HC.map.S2 / HC.map.S3) +
  plot_annotation( title = "Hierarchical Clustering of Samples Across Studies",
    theme = theme( plot.title = element_text(size = 18, face = "bold", hjust = 0.5)))

dds.S1A <- DESeq(dds.S1)
dds.S2A <- DESeq(dds.S2)
dds.S3A <- DESeq(dds.S3)

KOvsWT.S1 <-results(dds.S1A, contrast=c("genotype","KO","WT"), independentFiltering = TRUE , alpha = 0.05)
KOvsWT.S2 <-results(dds.S2A, contrast=c("genotype","KO","WT"), independentFiltering = TRUE , alpha = 0.05)
KOvsWT.S3 <-results(dds.S3A, contrast=c("genotype","KO","WT"), independentFiltering = TRUE , alpha = 0.05)

summary(KOvsWT.S1)
table(KOvsWT.S1$padj < 0.05)
summary(KOvsWT.S2)
table(KOvsWT.S2$padj < 0.05)
summary(KOvsWT.S3)
table(KOvsWT.S3$padj < 0.05)

write.table(as.data.frame(KOvsWT.S1[order(KOvsWT.S1$padj),] ), file="KO_vs_WT_dge.txt",sep="\t", quote = FALSE)
write.table(as.data.frame(KOvsWT.S2[order(KOvsWT.S2$padj),] ), file="KO_vs_WT_dge.txt",sep="\t", quote = FALSE)
write.table(as.data.frame(KOvsWT.S3[order(KOvsWT.S3$padj),] ), file="KO_vs_WT_dge.txt",sep="\t", quote = FALSE)

plotCounts(dds.S1A, gene="TREM2", intgroup="genotype")
plotCounts(dds.S2A, gene="TREM2", intgroup="genotype") 
plotCounts(dds.S3A, gene="TREM2", intgroup="genotype") 

KOvsWT_sorted.S1 <- KOvsWT.S1[order(KOvsWT.S1$padj),]
KOvsWT_sorted.S2 <- KOvsWT.S2[order(KOvsWT.S2$padj),]
KOvsWT_sorted.S3 <- KOvsWT.S3[order(KOvsWT.S3$padj),]

KOvsWT_top20.S1 <- head(KOvsWT_sorted.S1, n=20)
KOvsWT_top20.S2 <- head(KOvsWT_sorted.S2, n=20)
KOvsWT_top20.S3 <- head(KOvsWT_sorted.S3, n=20)

top20_genes_KOvsWT.S1 <- rownames(KOvsWT_top20.S1)
top20_genes_KOvsWT.S2 <- rownames(KOvsWT_top20.S2)
top20_genes_KOvsWT.S3 <- rownames(KOvsWT_top20.S3)

rlog.dge.S1 <- rld.S1[top20_genes_KOvsWT.S1,] %>% assay
rlog.dge.S2 <- rld.S2[top20_genes_KOvsWT.S2,] %>% assay
rlog.dge.S3 <- rld.S3[top20_genes_KOvsWT.S3,] %>% assay

heatmap.S1 <- pheatmap( rlog.dge.S1, scale = "row",
  main = "Differential Gene Expression (row-based z-score)", silent = TRUE)
heatmap.S2 <- pheatmap(rlog.dge.S2,scale = "row",
  main = "Differential Gene Expression (row-based z-score)", silent = TRUE)
heatmap.S3 <- pheatmap(rlog.dge.S3,scale = "row",
  main = "Differential Gene Expression (row-based z-score)",silent = TRUE)

heatmap.S1 <- as.ggplot(heatmap.S1$gtable)
heatmap.S2 <- as.ggplot(heatmap.S2$gtable)
heatmap.S3 <- as.ggplot(heatmap.S3$gtable)

Heatmap.top20 <- (heatmap.S1 / heatmap.S2 / heatmap.S3) + 
  plot_annotation(title = "Top 20 Differentially Expressed Genes per Study")
                                                   
ggsave("heatmaps.png", Heatmap.top20, width = 10, height = 18, dpi = 300)

