dexp.S1a_renamed <- dexp.S1A %>% rownames_to_column("gene") %>% rename(pvalue_1 = pvalue, log2FC_1 = log2FoldChange)
dexp.S2A_renamed <- dexp.S2A %>% rownames_to_column("gene") %>% rename(pvalue_2 = pvalue, log2FC_2 = log2FoldChange)
dexp.S3A_renamed <- dexp.S3A %>% rownames_to_column("gene") %>% rename(pvalue_3 = pvalue, log2FC_3 = log2FoldChange)

merged_dexp <- dexp.S1a_renamed %>% inner_join(dexp.S2A_renamed, by = "gene") %>% inner_join(dexp.S3A_renamed, by = "gene")

