p_mat[p_mat == 0] <- 1e-300

fisher_stat <- -2 * rowSums(log(p_mat))

fisher_p <- pchisq(fisher_stat, df = 6, lower.tail = FALSE)

merged_dexp$fisher_p <- fisher_p

merged_dexp$fisher_padj <- p.adjust(fisher_p, method = "BH")

merged_dexp$combined_log2FC <- rowMeans( merged_dexp[, c("log2FC_1", "log2FC_2", "log2FC_3")], na.rm = TRUE)

